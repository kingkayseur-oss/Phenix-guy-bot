def main():
    if not TOKEN:
        print("BOT_TOKEN manquant")
        return
    app = Application.builder().token(TOKEN).build()
    app.add_handler(CommandHandler(["menu","start","chaine","channel"], menu))
    app.add_handler(CommandHandler("allmenu", allmenu))
    app.add_handler(CommandHandler("play", play_cmd))
    app.add_handler(CommandHandler(["yt","tiktok","insta","fb","twitter"], yt_cmd))
    app.add_handler(CommandHandler("sticker", sticker_cmd))
    app.add_handler(CommandHandler("ping", ping_cmd))
    app.add_handler(CommandHandler("pair", pair_cmd))
    app.add_handler(CommandHandler("chaine", chaine_cmd))
    app.add_handler(MessageHandler(filters.StatusUpdate.NEW_CHAT_MEMBERS, welcome_handler))
    app.add_handler(MessageHandler(filters.StatusUpdate.LEFT_CHAT_MEMBER, goodbye_handler))
    print(f"{NAME} démarré")
    app.run_polling()

if __name__ == "__main__":
    main()