async def play_cmd(update, context):
    if not context.args:
        return await update.message.reply_text(".play dadju")
    q = " ".join(context.args)
    await update.message.reply_text(f"🔍 Recherche {q}...")
    try:
        video = yt_search(q)
        file_path, info = download_media(video['webpage_url'], audio=True)
        await update.message.reply_audio(open(file_path,'rb'), title=info.get('title',''))
    except Exception as e:
        await update.message.reply_text(f"Erreur: {e}")

async def yt_cmd(update, context):
    if not context.args:
        return await update.message.reply_text(".yt <lien>")
    await update.message.reply_text("⏳ Téléchargement...")
    try:
        file_path, info = download_media(context.args[0], audio=False)
        await update.message.reply_video(open(file_path,'rb'), caption=info.get('title','')[:200])
    except Exception as e:
        await update.message.reply_text(f"Erreur: {e}")

async def sticker_cmd(update, context):
    if not update.message.reply_to_message or not update.message.reply_to_message.photo:
        return await update.message.reply_text("Réponds à une photo avec .sticker")
    file = await update.message.reply_to_message.photo[-1].get_file()
    tmp1 = tempfile.mktemp(suffix=".jpg")
    await file.download_to_drive(tmp1)
    im = Image.open(tmp1)
    im.thumbnail((512,512))
    tmp2 = tempfile.mktemp(suffix=".webp")
    im.save(tmp2,"WEBP")
    await update.message.reply_sticker(open(tmp2,'rb'))

async def ping_cmd(update, context):
    start = time.time()
    msg = await update.message.reply_text("Ping...")
    await msg.edit_text(f"Pong {round((time.time()-start)*1000)}ms ⚡ {NAME}")

async def pair_cmd(update, context):
    if not context.args:
        return await update.message.reply_text(".pair 2438xxxxxxxx")
    number = context.args[0].replace("+","").replace(" ","")
    await update.message.reply_text(f"⏳ Génération code pour {number}...")
    try:
        resp = requests.get(f"{PAIR_SERVER}/pair?number={number}", timeout=25).json()
        if "code" in resp:
            await update.message.reply_text(f"✅ CODE: *{resp['code']}*\nVa dans WhatsApp > Appareils liés > Lier avec numéro", parse_mode="Markdown")
        else:
            await update.message.reply_text(str(resp))
    except Exception as e:
        await update.message.reply_text(f"Erreur pair: {e}")

